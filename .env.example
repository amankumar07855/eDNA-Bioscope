# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# SUPABASE_URL: Optional Supabase project URL for PostgreSQL and Storage.
SUPABASE_URL=

# SUPABASE_SERVICE_ROLE_KEY: Server-only Supabase service role key (never expose to client).
SUPABASE_SERVICE_ROLE_KEY=

# ADMIN_BOOTSTRAP_EMAILS: Comma-separated verified emails granted initial admin access on server.
ADMIN_BOOTSTRAP_EMAILS=
